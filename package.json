{
  "name": "agentica",
  "displayName": "Agentica",
  "version": "0.1.0",
  "description": "Syntax highlighting for Agentica, a language for AI agents",
  "license": "Apache-2.0",
  "publisher": "agentica-lang",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentica-lang/agc-tmlanguage"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "files": [
    "LICENSE",
    "README.md",
    "language-configuration.json",
    "syntaxes/agentica.tmLanguage.json"
  ],
  "contributes": {
    "languages": [
      {
        "id": "agentica",
        "aliases": [
          "Agentica",
          "agentica"
        ],
        "extensions": [
          ".agc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "agentica",
        "scopeName": "source.agentica",
        "path": "./syntaxes/agentica.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "test": "npm run test:grammar && npm run test:extension",
    "test:grammar": "vscode-tmgrammar-test -g syntaxes/agentica.tmLanguage.json \"test/**/*.agc\"",
    "test:extension": "node --test test/extension.test.mjs",
    "test:repo": "node script/tokenize-agentica-repo.mjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2",
    "ovsx": "1.2.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2",
    "vscode-tmgrammar-test": "0.1.3"
  }
}
